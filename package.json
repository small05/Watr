{
  "name": "watr",
  "version": "1.0.0",
  "description": "Web Action Trajectory Recorder - 网页操作轨迹结构化录制器",
  "main": "./out/main/index.js",
  "author": "Watr",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^25.1.0",
    "electron-vite": "^3.1.0",
    "typescript": "^5.7.0",
    "vue-tsc": "^2.2.0",
    "vite": "^6.3.0"
  },
  "build": {
    "appId": "com.watr.recorder",
    "productName": "Watr",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        },
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "tar.gz",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "category": "Utility"
    }
  }
}
